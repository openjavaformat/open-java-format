class WrappedArguments {
    void markers() {
        String message = Messages.format(
                "first argument that is long enough to matter", //$NON-NLS-1$
                "second argument that is also rather long", //$NON-NLS-1$
                "third one"); //$NON-NLS-1$
        String second = Messages.format(
                "first argument that is long enough to matter",
                "second argument that is also rather long", //$NON-NLS-1$
                "third one");
        String twoOnALine = Messages.format(
                "first argument that is long enough to matter", //$NON-NLS-1$
                "a" + "b", //$NON-NLS-1$ //$NON-NLS-2$
                "third argument that is also rather long"); //$NON-NLS-1$
        String keyAndValue = Messages.format(
                KEY,
                "an argument that is long enough to matter", //$NON-NLS-1$
                "second argument that is also rather long", //$NON-NLS-1$
                VALUE);
        String chained = builder.append("first argument that is long enough to matter") //$NON-NLS-1$
                .append("second argument that is also rather long") //$NON-NLS-1$
                .toString();
        String noSuchLiteral = Messages.format(
                "first argument that is long enough to matter", //$NON-NLS-1$
                "second argument that is also rather long",
                "third one"); //$NON-NLS-5$
        String fitsOnTheNextLine =
                Messages.format("first argument", "second one", "third"); //$NON-NLS-1$ //$NON-NLS-2$ //$NON-NLS-3$
    }
}
