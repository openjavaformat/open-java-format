# An unused single-type import from java.lang goes, also beside an import on demand (palantir-java-format#1778, #149).
----------
package p;
import java.lang.Byte;
import q.*;
public class Test { Short foo() { return null; } }
----------
package p;

import q.*;

public class Test {
    Short foo() {
        return null;
    }
}
