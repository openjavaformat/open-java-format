# An escaped backslash starts no escape of its own: \\t, \\n and \\r\\n stay text, and only the real \t and \n split the string.
----------
class T {
  String s = "fields split on \\t, lines on \\r\\n or \\n in C:\\temp\\new\\reports and \\\\server\\share for caf\u00e9\tthen\ndone";
}
----------
class T {
    String s =
            "fields split on \\t, lines on \\r\\n or \\n in C:\\temp\\new\\reports and \\\\server\\share for caf\u00e9"
                    + "\tthen\n"
                    + "done";
}
