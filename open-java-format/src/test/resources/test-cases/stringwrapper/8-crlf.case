# An escaped tab is a place to split the string, like a space, even inside a word.
----------
class T {
  String s = "onelongincrediblyunbrokensenten\tcethatwentonthroughbreakfastandlunchanddinnerandlongintothenightmovingfromtopictotopicsothatnoonehadachance tointerrupt";
}
----------
class T {
    String s = "onelongincrediblyunbrokensenten"
            + "\tcethatwentonthroughbreakfastandlunchanddinnerandlongintothenightmovingfromtopictotopicsothatnoonehadachance"
            + " tointerrupt";
}
