# A string with \n escapes in it is split after each of them.----------class T {  String s = "\n\none\nlong\nincredibly\nunbroken\nsentence\nmoving\nfrom\n topic\nto\n topic\nso\nthat\nno-one\nhad\na\nchance\nto\ninterrupt";}----------class T {    String s = "\n\n"            + "one\n"            + "long\n"            + "incredibly\n"            + "unbroken\n"            + "sentence\n"            + "moving\n"            + "from\n"            + " topic\n"            + "to\n"            + " topic\n"            + "so\n"            + "that\n"            + "no-one\n"            + "had\n"            + "a\n"            + "chance\n"            + "to\n"            + "interrupt";}