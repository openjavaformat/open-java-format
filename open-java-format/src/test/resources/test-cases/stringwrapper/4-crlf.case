# The literals on each side of the number are reflowed apart, and a word split between two literals is joined.
----------
class T {
  String s =
      "one long incredibly unbroken sentence that went on through breakfast and lunch and dinner and long into the night"
          + " moving from topic to topic"
          + 42
          + " so that no-one sitting anywhere near the long dining table, not even the host or the cook, had a chance to interr"
          + "upt";
}
----------
class T {
    String s = "one long incredibly unbroken sentence that went on through breakfast and lunch and dinner and long into"
            + " the night moving from topic to topic"
            + 42
            + " so that no-one sitting anywhere near the long dining table, not even the host or the cook, had"
            + " a chance to interrupt";
}
