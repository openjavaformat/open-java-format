# A long literal before a second semicolon is split at its one space, and the semicolon gets a line of its own.
----------
class T {
  String s =
      "onelongincrediblyunbrokensentencemovingfromtopictotopicsot atnoonehadachancetointerrupt______________________";;
}
----------
class T {
    String s = "onelongincrediblyunbrokensentencemovingfromtopictotopicsot"
            + " atnoonehadachancetointerrupt______________________";
    ;
}
