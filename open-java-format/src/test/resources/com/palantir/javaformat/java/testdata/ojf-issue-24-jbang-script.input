import picocli.CommandLine;
//SOURCES Helper.java
import picocli.CommandLine.Command;
//RUNTIME_OPTIONS --enable-preview
@Command(name = "hello",   mixinStandardHelpOptions = true)
class hello implements Runnable {
//DEPS org.example:in-class:1.0
    public void run() {System.out.println("Hello"); //DEPS org.example:trailing:1.0
    }

    public static void main(String... args) { System.exit(new CommandLine(new hello()).execute(args)); }
}
